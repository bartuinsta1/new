# cp .env.example .env  — bu dosya git'e GİRMEZ
# Borsa API anahtarı: SADECE "spot trade" izni verin, "withdraw/çekim" iznini KAPALI tutun, IP kısıtlaması ekleyin.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=        # OKX / KuCoin gibi passphrase isteyen borsalar için

BOT_MODE=paper                # paper | live (config.yaml'daki mode'u ezer)

CRYPTOPANIC_TOKEN=            # https://cryptopanic.com/developers/api/ (opsiyonel)
ANTHROPIC_API_KEY=            # haberleri Claude ile yorumlamak için (opsiyonel)

TELEGRAM_BOT_TOKEN=           # @BotFather'dan
TELEGRAM_CHAT_ID=
WEBHOOK_URL=                  # Discord/Slack/n8n/Zapier/Make webhook adresi (opsiyonel)
