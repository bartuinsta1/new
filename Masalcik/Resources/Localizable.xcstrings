            "state": "translated",
            "value": "Hear a sample"
          }
        }
      }
    },
    "Örneğin bir evcil hayvanın ya da büyükannenin kaybını konuşmak isterseniz açın. Masallar bu konuyu çok nazik ve umutlu biçimde işler.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örneğin bir evcil hayvanın ya da büyükannenin kaybını konuşmak isterseniz açın. Masallar bu konuyu çok nazik ve umutlu biçimde işler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on if, for example, you'd like to talk about losing a pet or a grandparent. Stories handle this very gently and hopefully."
          }
        }
      }
    },
