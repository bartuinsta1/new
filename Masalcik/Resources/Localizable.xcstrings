    "Adı sesli okurken bu yazımı kullanırız; ekranda her zaman asıl ad görünür.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adı sesli okurken bu yazımı kullanırız; ekranda her zaman asıl ad görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use this spelling when reading the name aloud; the real name is always shown on screen."
          }
        }
      }
    },
