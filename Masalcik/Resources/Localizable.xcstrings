    "Arkadaşınız uygulamayı indirip kodunuzu girerse ikiniz de 1 hafta Premium kazanırsınız. Her hesap bir kez kod kullanabilir.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşınız uygulamayı indirip kodunuzu girerse ikiniz de 1 hafta Premium kazanırsınız. Her hesap bir kez kod kullanabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your friend downloads the app and enters your code, you both get 1 week of Premium. Each account can use a code once."
          }
        }
      }
    },
