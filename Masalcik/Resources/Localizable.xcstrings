    "Hu hu… Gel bakalım küçük dostum, sana bir masal anlatayım.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hu hu… Gel bakalım küçük dostum, sana bir masal anlatayım."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoo hoo… Come here, little friend, let me tell you a story."
          }
        }
      }
    },
    "Hu hu… Masalcı Çınarı'nın gölgesine otur, sana eski bir masal anlatayım.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hu hu… Masalcı Çınarı'nın gölgesine otur, sana eski bir masal anlatayım."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoo hoo… Sit in the shade of the Storyteller Tree and I'll tell you an old, old tale."
          }
        }
      }
    },
