    "Çocuğunuz için yalnızca adını, yaşını ve ilgi alanlarını saklarız. Reklam yok, üçüncü taraf takip yok.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuğunuz için yalnızca adını, yaşını ve ilgi alanlarını saklarız. Reklam yok, üçüncü taraf takip yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your child we only keep their name, age and interests. No ads, no third-party tracking."
          }
        }
      }
    },
    "Çocuğunuzun adı masalda 3–5 kez geçecek.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuğunuzun adı masalda 3–5 kez geçecek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child's name will appear 3–5 times in each story."
          }
        }
      }
    },
    "Çıkartma": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
