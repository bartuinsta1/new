    "Bu bilgilerle masal saatini çocuğunuzun rutinine uyduruyoruz.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgilerle masal saatini çocuğunuzun rutinine uyduruyoruz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use this to fit story time into your child's routine."
          }
        }
      }
    },
    "Bu bölge henüz uyuyor. Masal dinledikçe uyanacak!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölge henüz uyuyor. Masal dinledikçe uyanacak!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This place is still asleep. It will wake up as you listen to more stories!"
          }
        }
      }
    },
    "Bu gece hangi rüyaya uçalım?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gece hangi rüyaya uçalım?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which dream shall we fly to tonight?"
