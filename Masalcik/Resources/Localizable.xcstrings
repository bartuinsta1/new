    },
    "Ücretsiz sürümde her gün 1 kişisel masal ve kitaplıktan haftada 3 masal. Kredi ya da jeton yok.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz sürümde her gün 1 kişisel masal ve kitaplıktan haftada 3 masal. Kredi ya da jeton yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free version includes 1 personal story every day and 3 library stories a week. No credits or tokens."
          }
        }
      }
    },
