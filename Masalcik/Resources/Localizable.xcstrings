            "state": "translated",
            "value": "Sticker"
          }
        }
      }
    },
    "Çıkartmalarım": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkartmalarım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My stickers"
          }
        }
      }
    },
    "Ödeme alındıysa Premium birkaç dakika içinde kendiliğinden açılır. Açılmazsa “Satın alımları geri yükle”ye dokunun.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme alındıysa Premium birkaç dakika içinde kendiliğinden açılır. Açılmazsa “Satın alımları geri yükle”ye dokunun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you were charged, Premium will turn on by itself within a few minutes. If it doesn't, tap “Restore purchases”."
          }
        }
      }
    },
    "Önce bir çocukla başlayalım; diğerlerini Ebeveyn Köşesi'nden ekleyebilirsiniz.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir çocukla başlayalım; diğerlerini Ebeveyn Köşesi'nden ekleyebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's start with one child; you can add the others from the Parent Corner."
          }
        }
      }
    },
    "Örn. Ayşe": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örn. Ayşe"
          }
        },
        "en": {
